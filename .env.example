ADMIN_DB_PATH=vietnam_admin_db/vietnam_administrative.json

# --- llamacpp (CPU local, recommended) ---
LLM_PROVIDER=llamacpp
LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_THREADS=6
LLM_NUM_CTX=1024
LLM_MAX_TOKENS=180
LLM_TIMEOUT_SECONDS=60

# --- ollama (nếu chạy ollama local) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b
# LLM_KEEP_ALIVE=10m

# --- openai_compatible (cloud/ngrok) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-url/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama

ENABLE_LLM=true
FUZZY_THRESHOLD=84
