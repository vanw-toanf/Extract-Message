ADMIN_DB_PATH=vietnam_admin_db/vietnam_administrative.json

# --- vLLM / openai_compatible (recommended: finetuned AWQ INT4 trên T4) ---
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://host.docker.internal:8001   # vLLM chạy trên host port 8001
LLM_MODEL=vin-extractor
LLM_API_KEY=ignored
LLM_NUM_CTX=1024
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=30

# --- ollama (fallback nếu không dùng vLLM) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=vin-extractor
# LLM_KEEP_ALIVE=10m

# --- llamacpp (CPU local, không cần GPU) ---
# LLM_PROVIDER=llamacpp
# LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLM_THREADS=6

ENABLE_LLM=true
FUZZY_THRESHOLD=84

# Concurrency control: trả 429 nếu queue đầy sau LLM_QUEUE_TIMEOUT_SECONDS giây
LLM_MAX_CONCURRENT=20          # vLLM xử lý batching nội bộ, có thể để cao
LLM_QUEUE_TIMEOUT_SECONDS=30
