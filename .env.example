ADMIN_DB_PATH=vietnam_admin_db/vietnam_administrative.json

# --- ollama (recommended: finetuned model trên T4) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://host.docker.internal:11434  # hoặc http://localhost:11434 nếu không dùng Docker
LLM_MODEL=vin-extractor                         # tên model sau khi ollama create
LLM_KEEP_ALIVE=10m
LLM_NUM_CTX=1024
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=60

# --- llamacpp (CPU local, không cần GPU) ---
# LLM_PROVIDER=llamacpp
# LLM_MODEL_PATH=models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# LLM_THREADS=6
# LLM_NUM_CTX=1024
# LLM_MAX_TOKENS=256
# LLM_TIMEOUT_SECONDS=60

# --- openai_compatible (cloud/ngrok) ---
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://your-url/v1
# LLM_MODEL=vin-extractor
# LLM_API_KEY=ollama

ENABLE_LLM=true
FUZZY_THRESHOLD=84

# Concurrency control: trả 429 nếu queue đầy sau LLM_QUEUE_TIMEOUT_SECONDS giây
LLM_MAX_CONCURRENT=3
LLM_QUEUE_TIMEOUT_SECONDS=15
